# Copy to .env; never commit the actual file. setup:local generates local-only credentials.
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
# Only set to 1 behind a private trusted reverse proxy; never expose the API directly.
TRUST_PROXY_HOPS=0
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://algolearn:CHANGE_ME@127.0.0.1:55432/algolearn
TEST_DATABASE_URL=postgresql://algolearn:CHANGE_ME@127.0.0.1:55432/algolearn_test
COOKIE_SECURE=false
# Development/test only: filesystem enables the loopback-only browser preview at
# http://localhost:5173/dev/mail-preview. It is rejected on non-loopback hosts.
# Production: set smtp and store credentials in deployment secret management.
MAIL_MODE=filesystem
# SMTP provider hostname. Port 587 normally uses STARTTLS with SMTP_SECURE=false;
# port 465 normally uses implicit TLS with SMTP_SECURE=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
# Authenticated SMTP credentials are mandatory in production. Never commit them.
SMTP_USER=
SMTP_PASSWORD=
# Use a provider-verified sender/domain in production; .local senders are rejected.
MAIL_FROM=AlgoLearn <noreply@your-institution.example>
BOOTSTRAP_ADMIN_EMAIL=admin@algolearn.local
POSTGRES_BIN=C:\Program Files\PostgreSQL\16\bin
# Required for code execution; leave unset until the dedicated host is verified.
JUDGE0_URL=
JUDGE0_API_KEY=
JUDGE0_ISOLATION_VERIFIED=false
# IDs must match the deployed /languages inventory; no hardcoded browser IDs.
JUDGE0_LANGUAGES=
JAVA_LIMITS_CALIBRATED=false
